<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);xUnit1051;CS1591;CA1707;CA1515;CA1861;CA2007;CA1063;CA1816;CA1001;CA1849;CA2000;CA1822;CA1859;CA1812;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA5394;CA1852;CA1031;CA2201;CA1024;CA1034;CA1819;CA1056;CA1054;CA2234;CA1002;CA1305;CA1062</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.MTP" />
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
</Project>
