root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,targets,csproj,slnx,xml,fga,proto,md,ts,html,scss}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Style
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
dotnet_style_qualification_for_field = false:warning
dotnet_style_readonly_field = true:warning

# Naming: private fields _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# Analyzer tuning (documented in docs/adr/0001)
dotnet_diagnostic.IDE0005.severity = warning      # unused usings
dotnet_diagnostic.CA1848.severity = suggestion    # LoggerMessage delegates: adopt per hot path
dotnet_diagnostic.CA1716.severity = none          # 'Error', 'Domain' are intentional names
dotnet_diagnostic.CA1711.severity = none          # 'EventHandler' suffixes in CQRS types
dotnet_diagnostic.CA1000.severity = none          # static factories on generic Result<T>
dotnet_diagnostic.CA1062.severity = none          # nullable reference types cover argument nulls
dotnet_diagnostic.CA1031.severity = suggestion    # catch-all in background loops is deliberate
dotnet_diagnostic.CA2007.severity = none          # no SynchronizationContext in ASP.NET Core
dotnet_diagnostic.CA1724.severity = none
dotnet_diagnostic.CA1515.severity = none          # public types required by module wiring and tests
dotnet_diagnostic.CA1812.severity = none          # types instantiated through DI
